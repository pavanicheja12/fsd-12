let express;
try {
    express = require('express');
} catch (err) {
    console.error("Missing dependency 'express'. Run: npm install express ejs");
    process.exit(1);
}

try {
    require('ejs');
} catch (err) {
    console.error("Missing dependency 'ejs'. Run: npm install ejs");
    process.exit(1);
}

const app = express();

// EJS setup
app.set('view engine', 'ejs');

// Read form data
app.use(express.urlencoded({ extended: true }));

// Home page
app.get('/', (req, res) => {
    res.render('index', {
        name: 'Beginner'
    });
});

// Form page
app.get('/form', (req, res) => {
    res.send(`
        <!DOCTYPE html>
        <html>
        <head>
            <title>Form Page</title>
        </head>
        <body>
            <h1>Submit Your Name</h1>

            <form action="/form" method="POST">
                <label>Name:</label>
                <input type="text" name="name" required>

                <button type="submit">Submit</button>
            </form>

            <br>
            <a href="/">Go Home</a>
        </body>
        </html>
    `);
});

// Form submission
app.post('/form', (req, res) => {
    const name = req.body.name;

    res.render('index', {
        name: name
    });
});

// Start server
app.listen(3000, () => {
    console.log('Server running on http://localhost:3000');
});